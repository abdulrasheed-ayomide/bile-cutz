# Frontend (public values only — NEVER put secrets here; everything prefixed VITE_ ships to the browser)
# Leave empty to call the API on the same origin (dev proxy, or a Vercel rewrite of /api to the backend).
VITE_API_URL=
# Origin of the Socket.IO server. Vercel cannot proxy WebSockets, so in production set this to the backend URL.
VITE_SOCKET_URL=
