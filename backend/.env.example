# ---------------------------------------------------------------------------
# Bile Cutz backend — copy to `.env` for local development.
# NEVER commit a real .env. In production set these in your host's dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Supabase → Project Settings → Database → Connection string.
# Use the *pooler* (port 6543, "transaction" mode) for the deployed app, or the
# direct/session connection (port 5432) for migrations. Include ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bilecutz
# Set to "true" when connecting to Supabase (TLS). Leave false for local Postgres.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Sessions / security ------------------------------------------------------
# Long random string (>= 32 chars): `openssl rand -base64 48`. Signs realtime tickets.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_DAYS=14
# Browser origins allowed to call the API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the frontend; used in emails (reset links).
FRONTEND_URL=http://localhost:5173
# If the frontend and API are on different sites (e.g. vercel.app + onrender.com) and
# you are NOT proxying /api through Vercel, set COOKIE_SAMESITE=none (requires HTTPS).
# With the recommended Vercel rewrite (/api -> backend) keep "lax".
COOKIE_SAMESITE=lax
# Set to your parent domain only if you need cookies shared across subdomains.
COOKIE_DOMAIN=
TRUST_PROXY=false

# --- Email (password recovery) ----------------------------------------------
# smtp        -> real delivery via SMTP (required in production)
# dev-outbox  -> writes emails to backend/.dev-outbox/*.json (development ONLY; refused in production)
EMAIL_PROVIDER=dev-outbox
EMAIL_FROM="Bile Cutz <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- File storage -------------------------------------------------------------
# local     -> files in backend/uploads (development; ephemeral on most hosts)
# supabase  -> Supabase Storage bucket (recommended in production)
STORAGE_PROVIDER=local
# Used only when STORAGE_PROVIDER=supabase. KEEP THE SERVICE ROLE KEY SERVER-SIDE ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bile-cutz-media
# Public base URL for locally stored files (this API's public URL), e.g. http://localhost:4000
PUBLIC_API_URL=http://localhost:4000

# --- Maintenance -----------------------------------------------------------------
# The server runs the safe cleanup (expired tokens/sessions, old notifications) every N hours. 0 disables.
CLEANUP_INTERVAL_HOURS=24

# --- Optional: first admin provisioning (used ONLY by `npm run admin:create`) ------
# Prefer passing these interactively / via the command line instead of storing them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
